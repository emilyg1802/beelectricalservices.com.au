<script>
let jobType='';
function selectOption(el,type){el.closest('.q-options').querySelectorAll('.q-option').forEach(b=>b.classList.remove('selected'));el.classList.add('selected');jobType=type;}
function nextStep(){document.querySelectorAll('.q-step').forEach(s=>s.classList.remove('active'));const map={exhaust:'step2-exhaust',fan:'step2-fan',lights:'step2-lights',other:'step2-other'};document.getElementById(map[jobType]).classList.add('active');document.getElementById('q-progress').style.width='60%';}
function goBack(){document.querySelectorAll('.q-step').forEach(s=>s.classList.remove('active'));document.getElementById('step1').classList.add('active');document.getElementById('q-progress').style.width='20%';}
function showPrice(price,job,includes){document.getElementById('r-price').textContent='$'+price;document.getElementById('r-job').textContent=job;const ul=document.getElementById('r-includes');ul.innerHTML='';includes.forEach(i=>{const li=document.createElement('li');li.textContent=i;ul.appendChild(li);});document.querySelectorAll('.q-step').forEach(s=>s.classList.remove('active'));document.getElementById('step-result').classList.add('active');document.getElementById('q-progress').style.width='100%';}
function resetQuote(){document.querySelectorAll('.q-step').forEach(s=>s.classList.remove('active'));document.getElementById('step1').classList.add('active');document.getElementById('q-progress').style.width='20%';jobType='';}
function toggleFaq(el){const a=el.querySelector('.faq-a');const c=el.querySelector('.faq-chevron');a.classList.toggle('open');c.classList.toggle('open');}
</script>
